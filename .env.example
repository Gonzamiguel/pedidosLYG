# Firebase Web App config (consola Firebase → Configuración del proyecto → Tus apps)
VITE_FIREBASE_API_KEY=tu_api_key
VITE_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tu-proyecto
VITE_FIREBASE_STORAGE_BUCKET=tu-proyecto.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef

# Email del administrador Master (Firebase Auth). Si está vacío, se usa demo local.
VITE_ADMIN_EMAIL=admin@viandapp.com

# Clave de acceso rápida al panel Master en modo demo (sin Firebase Auth)
VITE_ADMIN_DEMO_KEY=viandapp-master
